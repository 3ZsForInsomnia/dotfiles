#compdef skillz
# Generated by `skillz completions`. Regenerate after changing skillz's commands.

# _arguments passes its own compadd options (such as -J) to these; only --flags go to skillz.
_skillz_names() {
  local -a names
  names=(${(f)"$(skillz _names ${(M)@:#--*} 2>/dev/null)"})
  _describe 'skill' names ${@:#--*}
}

_skillz_namespaces() {
  local -a namespaces
  namespaces=(${(f)"$(skillz _namespaces 2>/dev/null)"})
  _describe 'namespace' namespaces "$@"
}

_skillz() {
  local -a commands
  commands=(
    'list:list every skill in the library with its status'
    'add:download skills from a source into the library'
    'remove:delete tracked skills and drop them from the lock'
    'move:move a skill to another namespace'
    'status:show tracked skills with local edits or upstream updates'
    'update:replace tracked skills with their upstream versions'
    'reset:restore skills to exactly what the lock records'
    'completions:print the zsh completion script'
  )
  _arguments -C '1: :->command' '*:: :->args'
  case $state in
    command) _describe 'command' commands ;;
    args)
      case $words[1] in
        list) _arguments \
          '(-j --json)'{-j,--json}'[print JSON instead of a table]' ;;
        add) _arguments \
          '(-n --namespace)'{-n,--namespace}'[namespace to install into (default: vendor/<owner>)]:namespace:_skillz_namespaces' \
          '1:source:' \
          '*:names:' ;;
        remove) _arguments \
          '*:names:_skillz_names --tracked' ;;
        move) _arguments \
          '1:name:_skillz_names --managed' \
          '2:namespace:_skillz_namespaces' ;;
        status) _arguments \
          '(-d --diff)'{-d,--diff}'[show a git diff for each change]' \
          '*:names:_skillz_names --tracked' ;;
        update) _arguments \
          '(-c --check)'{-c,--check}'[only report available updates]' \
          '(-f --force)'{-f,--force}'[overwrite local edits (requires skill names)]' \
          '*:names:_skillz_names --tracked' ;;
        reset) _arguments \
          '*:names:_skillz_names --tracked' ;;
        completions) ;;
      esac ;;
  esac
}

_skillz "$@"

