#compdef nvim-update

_nvim_update_history_shas() {
  local -a shas
  shas=(${(f)"$(nvim-update --history-shas 2>/dev/null)"})
  _describe 'previously installed version' shas
}

_arguments -s \
  '(-c --channel)'{-c,--channel}'[Release channel to target (default: nightly)]:channel:(nightly stable)' \
  '--upgrade[Upgrade to latest upstream version]' \
  '--rollback[Rebuild and install a previously installed version]::previously installed version:_nvim_update_history_shas' \
  '--history[Print recorded upgrade/rollback history]' \
  '--version[Print current tag and commit SHA]' \
  '--logfile[Show most recent logfile path]' \
  '--checkout=[Manually check out given commit SHA]:commit sha: '
