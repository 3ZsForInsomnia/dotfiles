#!/usr/bin/env python3
"""Print the review notes file for a GitHub PR, creating it first if needed.

Notes live in $XDG_DATA_HOME/pr-reviews/<owner>-<repo>-<number>.md and hold
what a review produces: findings, investigations, and decisions. Prints the file's path, whether it was just
created, and its contents. Run it from inside the PR's repository.
"""

import json
import os
import subprocess
from argparse import ArgumentParser
from pathlib import Path

PR_REVIEWS_DIR = Path(os.environ["XDG_DATA_HOME"]) / "pr-reviews"
SECTIONS = ("Pre-review", "Files", "Investigations", "Second round", "Decisions", "Post-review summary")


def gh_json(command: list[str]) -> dict:
    return json.loads(subprocess.run(["gh", *command], capture_output=True, text=True, check=True).stdout)


def notes_path(number: int) -> Path:
    repo = gh_json(["repo", "view", "--json", "owner,name"])

    return PR_REVIEWS_DIR / f"{repo['owner']['login']}-{repo['name']}-{number}.md"


def skeleton(number: int) -> str:
    pr = gh_json(["pr", "view", str(number), "--json", "title,url"])
    sections = "\n\n".join(f"## {section}" for section in SECTIONS)

    return f"# #{number}: {pr['title']}\n\n{pr['url']}\n\n{sections}\n"


def main() -> None:
    parser = ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("number", type=int, help="PR number")
    number = parser.parse_args().number

    path = notes_path(number)
    is_new = not path.exists()
    if is_new:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(skeleton(number))

    print(f"{path} ({'created' if is_new else 'existing'})\n")
    print(path.read_text())


if __name__ == "__main__":
    main()
